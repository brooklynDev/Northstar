<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Northstar.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="Northstar.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/northstar-icon.ico"
        Title="Northstar Explorer"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10131A" Offset="0" />
                    <GradientStop Color="#0A0D12" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Border.chrome">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#2A3140" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#131923" />
        </Style>

        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="#1A2231" />
            <Setter Property="BorderBrush" Value="#283246" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="#222E42" />
            <Setter Property="Foreground" Value="#CED8E8" />
            <Setter Property="BorderBrush" Value="#3A465D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#2A3750" />
        </Style>

        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="#32415E" />
        </Style>

        <Style Selector="Button.sideItemButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Foreground" Value="#D4DDF0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style Selector="Button.sideItemButton:pointerover">
            <Setter Property="Background" Value="#202B3D" />
            <Setter Property="BorderBrush" Value="#2E3B54" />
        </Style>

        <Style Selector="Button.crumbButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="#DCE6F8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Button.crumbButton:pointerover">
            <Setter Property="Background" Value="#223048" />
        </Style>

        <Style Selector="Border.pathSurface">
            <Setter Property="Background" Value="#0E131D" />
            <Setter Property="BorderBrush" Value="#2A344A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style Selector="Button.columnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#97A2B7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style Selector="Button.columnHeader:pointerover">
            <Setter Property="Foreground" Value="#C7D4EB" />
        </Style>

        <Style Selector="Button.terminalToggle">
            <Setter Property="Background" Value="#1C2738" />
            <Setter Property="Foreground" Value="#CFE0F6" />
            <Setter Property="BorderBrush" Value="#35445D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style Selector="Button.terminalToggle:pointerover">
            <Setter Property="Background" Value="#233149" />
        </Style>

        <Style Selector="Border.previewPane">
            <Setter Property="Background" Value="#0D1522" />
            <Setter Property="BorderBrush" Value="#2A344A" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style Selector="TextBox.previewText">
            <Setter Property="Background" Value="#0A111C" />
            <Setter Property="BorderBrush" Value="#2A344A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#D6E4FA" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="ListBox#ExplorerList ListBoxItem:pointerover TextBlock.fileName">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="ListBox#ExplorerList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Background" Value="#121A28" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox#ExplorerList ListBoxItem:pointerover">
            <Setter Property="Background" Value="#1C273A" />
        </Style>

        <Style Selector="ListBox#ExplorerList ListBoxItem:selected">
            <Setter Property="Background" Value="#28405B" />
        </Style>
    </Window.Styles>

    <Border Classes="chrome" Margin="14">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Classes="toolbar">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="nav" Command="{Binding GoBackCommand}" Content="←" />
                        <Button Classes="nav" Command="{Binding GoForwardCommand}" Content="→" />
                        <Button Classes="nav" Command="{Binding GoUpCommand}" Content="↑" />
                        <Button Classes="nav" Command="{Binding RefreshCommand}" Content="↻" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <Border Classes="pathSurface"
                                IsVisible="{Binding IsPathReadMode}"
                                PointerPressed="PathSurface_OnPointerPressed">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <ItemsControl ItemsSource="{Binding BreadcrumbItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BreadcrumbItemViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="crumbButton"
                                                            Command="{Binding $parent[Window].DataContext.NavigateToBreadcrumbCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding Label}" />
                                                    <TextBlock Text="›"
                                                               Foreground="#71839E"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <TextBox x:Name="PathEditBox"
                                 IsVisible="{Binding IsPathEditMode}"
                                 Text="{Binding PathInputText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="PathEditBox_OnKeyDown"
                                 LostFocus="PathEditBox_OnLostFocus"
                                 Background="#0E131D"
                                 BorderBrush="#2A344A"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 Foreground="#E8F0FF"
                                 Padding="10,7" />

                        <TextBox Watermark="Search this folder"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0E131D"
                                 BorderBrush="#2A344A"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 Foreground="#E8F0FF"
                                 Padding="10,7" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="nav"
                                Command="{Binding OpenSelectedCommand}"
                                Content="Open Selected"
                                MinWidth="120" />
                        <Button Classes="nav"
                                Click="PreferencesButton_OnClick"
                                Content="⚙"
                                ToolTip.Tip="Preferences" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="MainContentGrid" ColumnDefinitions="290,*,360">
                <Border Background="#161E2D" BorderBrush="#29334A" BorderThickness="0,0,1,0" Padding="14,12">
                    <ScrollViewer>
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Quick Access" Foreground="#9EA9BD" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding QuickAccessItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuickAccessItemViewModel">
                                            <Button Classes="sideItemButton"
                                                    Command="{Binding $parent[Window].DataContext.OpenQuickAccessCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Glyph}" Foreground="#8DB0E2" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Label}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="This Folder" Foreground="#9EA9BD" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SidebarFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuickAccessItemViewModel">
                                            <Button Classes="sideItemButton"
                                                    Command="{Binding $parent[Window].DataContext.OpenQuickAccessCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Glyph}" Foreground="#95B8EA" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Label}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Background="#101823" Padding="0,8,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="3.2*,1.4*,1.1*,1.8*" Margin="16,0,16,8">
                            <Button Classes="columnHeader"
                                    Command="{Binding SortByCommand}"
                                    CommandParameter="Name">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Name" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding NameSortIndicator}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Classes="columnHeader"
                                    Command="{Binding SortByCommand}"
                                    CommandParameter="Type">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Type" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TypeSortIndicator}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="columnHeader"
                                    Command="{Binding SortByCommand}"
                                    CommandParameter="Size">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Size" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SizeSortIndicator}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="columnHeader"
                                    Command="{Binding SortByCommand}"
                                    CommandParameter="Modified">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Modified" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ModifiedSortIndicator}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="ExplorerList"
                                 ItemsSource="{Binding ExplorerItems}"
                                 SelectedItem="{Binding SelectedExplorerItem}"
                                 SelectionChanged="ExplorerList_OnSelectionChanged"
                                 DoubleTapped="ExplorerList_OnDoubleTapped"
                                 TextInput="ExplorerList_OnTextInput"
                                 KeyDown="ExplorerList_OnKeyDown"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="8,0,8,8">
                            <ListBox.ContextMenu>
                                <ContextMenu Opening="ExplorerContextMenu_OnOpening">
                                    <MenuItem Header="Open" Click="OpenItemMenu_OnClick" />
                                    <Separator />
                                    <MenuItem Header="Rename" Click="RenameItemMenu_OnClick" />
                                    <Separator />
                                    <MenuItem Header="Copy" Click="CopyItemMenu_OnClick" />
                                    <MenuItem Header="Cut" Click="CutItemMenu_OnClick" />
                                    <MenuItem Header="Paste" Click="PasteMenu_OnClick" />
                                    <Separator />
                                    <MenuItem Header="Copy Path" Click="CopyPathMenu_OnClick" />
                                    <MenuItem Header="Move to Trash" Click="DeleteItemMenu_OnClick" />
                                    <Separator />
                                    <MenuItem Header="New Folder" Click="NewFolderMenu_OnClick" />
                                    <MenuItem Header="Refresh" Click="RefreshMenu_OnClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileSystemItemViewModel">
                                    <Grid ColumnDefinitions="3.2*,1.4*,1.1*,1.8*"
                                          Margin="8,10"
                                          PointerPressed="ExplorerRow_OnPointerPressed">
                                        <Grid.ContextMenu>
                                            <ContextMenu Opening="ExplorerContextMenu_OnOpening">
                                                <MenuItem Header="Open" Click="OpenItemMenu_OnClick" Tag="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Rename" Click="RenameItemMenu_OnClick" Tag="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Copy" Click="CopyItemMenu_OnClick" Tag="{Binding}" />
                                                <MenuItem Header="Cut" Click="CutItemMenu_OnClick" Tag="{Binding}" />
                                                <MenuItem Header="Paste" Click="PasteMenu_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Copy Path" Click="CopyPathMenu_OnClick" Tag="{Binding}" />
                                                <MenuItem Header="Move to Trash" Click="DeleteItemMenu_OnClick" Tag="{Binding}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Stretch="Uniform" />
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Classes="fileName"
                                                       Text="{Binding Name}"
                                                       Foreground="#CFE2FF"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#C8D3E6" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#C8D3E6" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Modified}" Foreground="#C8D3E6" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" x:Name="PreviewPane" Classes="previewPane" IsVisible="False">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <TextBlock x:Name="PreviewTitle"
                                   Text="Quick Preview"
                                   Foreground="#E5EEFF"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1"
                                   x:Name="PreviewMeta"
                                   Margin="0,4,0,10"
                                   Foreground="#8FA2BF"
                                   FontSize="12"
                                   Text="Press Space to toggle preview." />

                        <Grid Grid.Row="2">
                            <Border x:Name="PreviewMessageSurface"
                                    CornerRadius="10"
                                    Background="#0A111C"
                                    BorderBrush="#2A344A"
                                    BorderThickness="1">
                                <TextBlock x:Name="PreviewMessageText"
                                           Margin="14"
                                           Text="Select a file and press Space."
                                           Foreground="#9EB1CC"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Image x:Name="PreviewImage"
                                   IsVisible="False"
                                   Stretch="Uniform" />

                            <TextBox x:Name="PreviewTextBox"
                                     Classes="previewText"
                                     IsVisible="False"
                                     Focusable="False"
                                     IsTabStop="False"
                                     VerticalContentAlignment="Top"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0"
                                     Padding="10" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#0F1623" BorderBrush="#283246" BorderThickness="1,1,0,0" Padding="10,8">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Northstar Explorer"
                               Foreground="#6F84A4"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <Button Grid.Column="1"
                            Classes="terminalToggle"
                            Click="OpenTerminalButton_OnClick"
                            Content="⌨ Open Terminal"
                            HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</Window>
